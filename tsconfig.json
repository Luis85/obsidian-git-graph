{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2022"],
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "tests/**/*.ts",
    "harness/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vite.harness.config.ts",
    "playwright.config.ts"
  ]
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "vue"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", ".obsidian/**", ".superpowers/**", "docs/**", "coverage/**"],
  "overrides": [
    {
      "files": ["src/util/emitter.ts"],
      "rules": {
        // `[...listeners]` snapshots the Set before iterating so a listener that
        // unsubscribes itself (or another listener) mid-emit doesn't skip a callback
        // that was already due to run. Removing the spread would change that behavior.
        "unicorn/no-useless-spread": "off"
      }
    },
    {
      "files": ["src/view/CommitRow.vue"],
      "rules": {
        // `[...props.refs].sort(...)` already sorts a copy, never `props.refs` itself;
        // `toSorted()` would be equivalent but needs an ES2023 lib target this project
        // doesn't otherwise require, so the spread+sort form stays.
        "unicorn/no-array-sort": "off"
      }
    }
  ],
  "rules": {}
}

{
  "name": "obsidian-git-graph",
  "version": "0.1.0",
  "description": "VS Code's source control graph as an Obsidian side pane.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test-build": "npm run typecheck && vite build --mode development && node scripts/test-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint": "npm run lint:oxlint && npm run lint:eslint",
    "deadcode": "fallow dead-code",
    "loc": "node scripts/loc.mjs",
    "harness": "vite --config vite.harness.config.ts",
    "harness:build": "vite build --config vite.harness.config.ts",
    "harness:install": "playwright install chromium",
    "screenshot": "node scripts/screenshot.mjs",
    "check": "npm run build && npm run lint && npm run deadcode && npm run loc && npm run test:coverage"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "git",
    "graph"
  ],
  "author": "Luis85",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.9.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-oxlint": "^1.81.0",
    "eslint-plugin-vue": "^10.10.0",
    "fallow": "^3.22.0",
    "jsdom": "^30.0.1",
    "lucide": "^1.41.0",
    "obsidian": "1.13.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "vue": "^3.5.41"
  }
}
